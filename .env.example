# Copy to .env and adjust. Every variable is optional; defaults are shown.
# Validated at startup by src/lib/config/server.ts and src/lib/config/public.ts.

# --- Server-only -------------------------------------------------------------

# Where portfolio content comes from. Only "json" (src/data/*.json) is implemented.
# Pages are prerendered at build time, so set this before `npm run build`.
DATA_SOURCE=json

# Comma-separated origins allowed to call the /api routes from a browser
# (e.g. a separate chatbot app). Empty = no cross-origin access. "*" = any origin.
# Example: CORS_ALLOWED_ORIGINS=http://localhost:4000,https://chat.example.com
CORS_ALLOWED_ORIGINS=

# Placeholders for a future remote content source (headless CMS or content API).
# Not used by the json source.
CONTENT_API_URL=
CONTENT_API_TOKEN=

# --- Public (inlined into the browser bundle at build time) ------------------

# Canonical site URL, used for metadata and Open Graph links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Future integration: URL of the separate chatbot app. Not used yet.
NEXT_PUBLIC_CHATBOT_URL=
